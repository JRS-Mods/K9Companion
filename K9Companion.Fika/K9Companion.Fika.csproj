<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>K9Companion.Fika</AssemblyName>
    <Version>1.3.2</Version>
    <Authors>JRS</Authors>
    <Company>JRS</Company>
    <Copyright>Copyright © 2026 JRS</Copyright>
    <RootNamespace>K9Companion.Fika</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <SPTPath Condition="'$(SPTPath)' == ''">F:\SPT</SPTPath>
    <Managed>$(SPTPath)\EscapeFromTarkov_Data\Managed</Managed>
    <!-- Only to build against: it's never shipped. Parked or active, whichever is there. -->
    <FikaCore>$(SPTPath)\BepInEx\plugins\Fika\Fika.Core.dll</FikaCore>
    <FikaCore Condition="!Exists('$(FikaCore)')">$(SPTPath)\_mods_disabled\BepInEx\plugins\Fika\Fika.Core.dll</FikaCore>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="K9Companion" HintPath="..\K9Companion\bin\Release\K9Companion.dll" Private="false" />
    <Reference Include="BepInEx" HintPath="$(SPTPath)\BepInEx\core\BepInEx.dll" Private="false" />
    <Reference Include="Fika.Core" HintPath="$(FikaCore)" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(Managed)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="Comfort" HintPath="$(Managed)\Comfort.dll" Private="false" />
    <Reference Include="Comfort.Unity" HintPath="$(Managed)\Comfort.Unity.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(Managed)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(Managed)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="ItemComponent.Types" HintPath="$(Managed)\ItemComponent.Types.dll" Private="false" />
  </ItemGroup>

</Project>
